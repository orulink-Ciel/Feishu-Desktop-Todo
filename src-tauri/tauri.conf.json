{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "轻列便签",
  "version": "0.1.7",
  "identifier": "com.personal.feishu-desktop-todo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "轻列便签",
        "width": 420,
        "height": 700,
        "minWidth": 360,
        "minHeight": 460,
        "decorations": false,
        "shadow": false,
        "resizable": true,
        "alwaysOnTop": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["nsis"],
    "resources": ["resources/lark-cli.exe", "resources/LARK-CLI-LICENSE"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"],
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/orulink-Ciel/Feishu-Desktop-Todo/releases/download/desktop-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGNzM1RTk4NjA5NDREOUQKUldTZFRaUmdtRjV6VDdiRUtYVW1JYlE5Q2ZmaXRMSXk2a0l0MW9KUXVTVXhoOERCT0ZMSzZ3R3oK"
    }
  }
}
