{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "飞书桌面待办",
  "version": "0.1.0",
  "identifier": "com.personal.feishu-desktop-todo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "飞书桌面待办",
        "width": 420,
        "height": 700,
        "minWidth": 360,
        "minHeight": 460,
        "decorations": false,
        "shadow": false,
        "resizable": true,
        "alwaysOnTop": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/lark-cli.exe", "resources/LARK-CLI-LICENSE"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"],
        "installMode": "currentUser"
      }
    }
  }
}
